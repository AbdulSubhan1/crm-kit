diff --git a/server/db/schema.ts b/server/db/schema.ts
index f84c30d..7b12165 100644
--- a/server/db/schema.ts
+++ b/server/db/schema.ts
@@ -1,4 +1,4 @@
-import { boolean, integer, pgTable, primaryKey, serial, text, timestamp } from "drizzle-orm/pg-core";
+import { boolean, integer, pgTable, primaryKey, serial, text, timestamp, uuid } from "drizzle-orm/pg-core";
 
 // The platform tables every CRM starts with. Business tables are added by each CRM's modules.
 
@@ -50,3 +50,19 @@ export const auditLogs = pgTable("audit_logs", {
   details: text("details").notNull().default(""),
   createdAt: timestamp("created_at").notNull().defaultNow(),
 });
+
+/** People the business works with. Links use publicId; people quote the reference, e.g. CON-J2M3HX7. */
+export const contacts = pgTable("contacts", {
+  id: serial("id").primaryKey(),
+  publicId: uuid("public_id").notNull().unique().defaultRandom(),
+  reference: text("reference").notNull().unique(),
+  name: text("name").notNull(),
+  email: text("email").notNull(),
+  phone: text("phone").notNull(),
+  notes: text("notes").notNull().default(""),
+  // Scope columns: the team that sees it and the person who owns it
+  teamId: integer("team_id").references(() => teams.id),
+  ownerId: integer("owner_id").references(() => users.id),
+  createdAt: timestamp("created_at").notNull().defaultNow(),
+  updatedAt: timestamp("updated_at").notNull().defaultNow(),
+});
